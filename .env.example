# Neon Postgres (provisioned by the Vercel Marketplace integration; `vercel env pull .env.local`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI Gateway auth: on Vercel, OIDC is automatic. Locally, `vercel env pull` provides VERCEL_OIDC_TOKEN,
# or set an AI Gateway API key instead.
# AI_GATEWAY_API_KEY=

# Optional tuning
# LLM_MODEL=google/gemini-2.5-flash-lite
# LLM_FALLBACK_MODEL=openai/gpt-4.1-mini
# DAILY_LLM_BUDGET_USD=2
# RATE_PARSES_PER_10MIN=8
# RATE_PARSES_PER_DAY=40
# RATE_MEETINGS_PER_HOUR=10
# IP_HASH_SALT=change-me

# Local Chrome used to read scheduling links in development (on Vercel, @sparticuz/chromium is used)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Google Calendar connection (optional; the button is hidden unless all three are set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
# CALENDAR_TOKEN_KEY=
